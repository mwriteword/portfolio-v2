---
// Fixed "back to top" button; appears after scrolling down.
---

<button type="button" data-back-to-top hidden aria-label="Back to top" class="fixed bottom-6 right-6 z-40 flex h-10 w-10 items-center justify-center rounded-full border border-white/10 bg-[#242424] text-white shadow-lg transition-colors hover:bg-[#333333]">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="18 15 12 9 6 15"/></svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>("[data-back-to-top]");
  const onScroll = () => btn?.toggleAttribute("hidden", window.scrollY < 400);
  window.addEventListener("scroll", onScroll, { passive: true });
  onScroll();
  btn?.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
</script>
