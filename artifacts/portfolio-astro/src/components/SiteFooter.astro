---
import { getCollection } from "astro:content";

const LINKEDIN_URL = "https://linkedin.com/in/vjtlaq";
const MEDIUM_URL = "https://medium.com/@vjtlaq";
const year = new Date().getFullYear();

// The 5 real case studies (order < 10), sorted, for the Portfolio column.
const studies = (await getCollection("caseStudies", ({ data }) => !data.draft && data.order < 10)).sort(
  (a, b) => a.data.order - b.data.order,
);

const core = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/portfolio", label: "Portfolio" },
  { href: "/about", label: "About" },
  { href: "/#contact", label: "Contact" },
];

const linkCls = "text-sm text-muted-foreground transition-colors hover:text-foreground";
---

<footer class="border-t border-border bg-muted/40">
  <div class="max-w-[1120px] w-[90%] mx-auto py-12 sm:py-16">
    <div class="flex flex-col gap-10 sm:flex-row sm:justify-between">
      <!-- Identity -->
      <div class="max-w-xs">
        <p class="text-lg font-semibold tracking-tight text-foreground">Words By Vern</p>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          UX content consulting for B2B SaaS and regulated industries.
        </p>
        <div class="mt-5 flex items-center gap-4">
          <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn" class="text-muted-foreground transition-colors hover:text-foreground">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-[18px] w-[18px]"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href={MEDIUM_URL} target="_blank" rel="noopener noreferrer" aria-label="Medium" class="text-muted-foreground transition-colors hover:text-foreground">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-[18px] w-[18px]"><path d="M13.54 12a6.8 6.8 0 0 1-6.77 6.82A6.8 6.8 0 0 1 0 12a6.8 6.8 0 0 1 6.77-6.82A6.8 6.8 0 0 1 13.54 12zm7.42 0c0 3.54-1.51 6.42-3.38 6.42-1.87 0-3.39-2.88-3.39-6.42s1.52-6.42 3.39-6.42 3.38 2.88 3.38 6.42zM24 12c0 3.17-.53 5.75-1.19 5.75-.66 0-1.19-2.58-1.19-5.75s.53-5.75 1.19-5.75C23.47 6.25 24 8.83 24 12z"/></svg>
          </a>
        </div>
      </div>

      <!-- Link columns -->
      <div class="grid grid-cols-2 gap-10 sm:gap-16">
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-muted-foreground/70">Core</p>
          <ul class="space-y-2.5">
            {core.map((l) => <li><a href={l.href} class={linkCls}>{l.label}</a></li>)}
          </ul>
        </div>
        <div>
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-muted-foreground/70">Portfolio</p>
          <ul class="space-y-2.5">
            {studies.map((s) => (
              <li><a href={`/portfolio/case-study/${s.id}`} class={linkCls}>{s.data.title}</a></li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-sm text-muted-foreground">© {year} Vernon Laquindanum</p>
  </div>
</footer>
