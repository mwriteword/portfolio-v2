---
// Expandable sample grid. Tiles render in a grid; clicking one reveals a
// full-width panel with the sample's media + body. All panel bodies render into
// the DOM (crawlable) — the script only toggles visibility.
export interface Sample {
  id: string;
  title: string;
  category: string;
  preview: string;
  image?: string;
  full?: string;
  video?: string;
  imageTop?: boolean;
  bodyHtml: string;
}
const { samples } = Astro.props as { samples: Sample[] };
const gradients = [
  "from-blue-500/25 to-indigo-500/10",
  "from-emerald-500/25 to-teal-500/10",
  "from-amber-500/25 to-orange-500/10",
  "from-fuchsia-500/25 to-purple-500/10",
  "from-rose-500/25 to-pink-500/10",
  "from-cyan-500/25 to-sky-500/10",
];
---

<div data-ws class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
  {
    samples.map((s, i) => (
      <button type="button" data-ws-tile={s.id} aria-expanded="false" class="ws-tile group flex flex-col overflow-hidden rounded-xl border border-border bg-card text-left transition-colors hover:bg-muted">
        <div class={`aspect-[4/3] w-full overflow-hidden bg-gradient-to-br ${gradients[i % gradients.length]}`}>
          {s.image && (
            <img src={s.image} alt={s.title} class={`h-full w-full object-cover ${s.imageTop ? "object-top" : ""}`} onerror="this.style.display='none'" />
          )}
        </div>
        <div class="flex items-start justify-between gap-2 p-4">
          <div>
            <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{s.category}</span>
            <h3 class="mt-1 font-semibold">{s.title}</h3>
            <p class="mt-1.5 text-sm text-muted-foreground">{s.preview}</p>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="ws-arrow mt-0.5 shrink-0 text-muted-foreground transition-transform group-hover:text-foreground"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
        </div>
      </button>
    ))
  }
  {
    samples.map((s, i) => (
      <div data-ws-panel={s.id} hidden class="col-span-full overflow-hidden rounded-xl border border-border bg-card">
        <div class="grid gap-6 p-5 sm:p-6 lg:grid-cols-2">
          <div class={`aspect-[16/10] w-full overflow-hidden rounded-lg bg-gradient-to-br ${gradients[i % gradients.length]}`}>
            {
              s.video ? (
                <video src={s.video} poster={s.image} controls preload="metadata" class="h-full w-full object-cover" />
              ) : s.image ? (
                <button type="button" data-zoomable data-src={s.full ?? s.image} data-alt={s.title} aria-label={`Expand image: ${s.title}`} class="group block h-full w-full cursor-zoom-in">
                  <img src={s.image} alt={s.title} class={`h-full w-full object-cover transition-transform duration-300 ease-out group-hover:scale-[1.03] ${s.imageTop ? "object-top" : ""}`} onerror="this.style.display='none'" />
                </button>
              ) : null
            }
          </div>
          <div class="flex flex-col">
            <div class="flex items-start justify-between gap-4">
              <span class="text-xs font-medium uppercase tracking-wide text-muted-foreground">{s.category}</span>
              <button type="button" data-ws-close aria-label="Close" class="-m-1 rounded-md p-1 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
              </button>
            </div>
            <h3 class="mt-2 text-xl font-semibold">{s.title}</h3>
            <div class="mt-3 space-y-3 text-sm leading-relaxed text-muted-foreground [&_a]:font-medium [&_a]:text-primary [&_a:hover]:underline [&_em]:italic [&_ul]:list-disc [&_ul]:space-y-1 [&_ul]:pl-5" set:html={s.bodyHtml} />
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-ws]").forEach((group) => {
    const tiles = group.querySelectorAll<HTMLElement>("[data-ws-tile]");
    const panels = group.querySelectorAll<HTMLElement>("[data-ws-panel]");
    const closeAll = () => {
      panels.forEach((p) => p.setAttribute("hidden", ""));
      tiles.forEach((t) => {
        t.setAttribute("aria-expanded", "false");
        t.querySelector(".ws-arrow")?.classList.remove("rotate-90");
      });
    };
    tiles.forEach((t) => {
      t.addEventListener("click", () => {
        const id = t.dataset.wsTile!;
        const panel = [...panels].find((p) => p.dataset.wsPanel === id);
        if (!panel) return;
        const isOpen = !panel.hasAttribute("hidden");
        closeAll();
        if (!isOpen) {
          panel.removeAttribute("hidden");
          t.setAttribute("aria-expanded", "true");
          t.querySelector(".ws-arrow")?.classList.add("rotate-90");
          panel.scrollIntoView({ behavior: "smooth", block: "nearest" });
        }
      });
    });
    group.querySelectorAll("[data-ws-close]").forEach((btn) => btn.addEventListener("click", closeAll));
  });
</script>
