---
// Responsive grid for side-by-side <Figure> blocks (before/after, comparisons).
// Figures inside render as grid cells (no float), so pass align="full" to them.
interface Props {
  /** Columns at sm+ (default 2). */
  cols?: 2 | 3;
}
const { cols = 2 } = Astro.props;
const grid = cols === 3 ? "sm:grid-cols-3" : "sm:grid-cols-2";
---
<div class={`not-prose my-6 grid grid-cols-1 ${grid} gap-4`}>
  <slot />
</div>
