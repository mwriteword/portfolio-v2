---
import Layout from "./Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import BackToTop from "../components/BackToTop.astro";
import Lightbox from "../components/Lightbox.astro";

// Shared shell for every case study. Light, unified theme. Renders the header
// (breadcrumb, title, tagline), the meta sidebar + high-level summary/teaser
// from frontmatter, then the MDX body via <slot />. Section anchors for the nav
// are derived from the body's `##` headings and passed in as `sections`.
interface Props {
  title: string;
  tagline: string;
  description: string;
  path: string;
  role: string;
  company: string;
  timeline: string;
  collaborators?: string[];
  skills?: string[];
  accent: string;
  summary: string;
  /** Section anchors (id → label), derived from the MDX H2 headings. */
  sections?: { id: string; label: string }[];
  jsonLd?: Record<string, unknown>[];
}
const {
  title,
  tagline,
  description,
  path,
  role,
  company,
  timeline,
  collaborators = [],
  skills = [],
  accent,
  summary,
  sections = [],
  jsonLd = [],
} = Astro.props;

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description,
  author: { "@type": "Person", name: "Vernon Laquindanum", url: "https://wordsbyvern.com/about" },
  mainEntityOfPage: { "@type": "WebPage", "@id": `https://wordsbyvern.com${path}` },
};
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Portfolio", item: "https://wordsbyvern.com/portfolio" },
    { "@type": "ListItem", position: 2, name: title, item: `https://wordsbyvern.com${path}` },
  ],
};

const metaRows = [
  { label: "Role", value: role },
  { label: "Company", value: company },
  { label: "Timeline", value: timeline },
  ...(collaborators.length ? [{ label: "Collaborators", value: collaborators.join(", ") }] : []),
  ...(skills.length ? [{ label: "In this case study", value: skills.join(", ") }] : []),
];
---

<Layout title={`${title} — Vernon Laquindanum`} description={description} path={path} jsonLd={[articleSchema, breadcrumb, ...jsonLd]}>
  <main class="min-h-screen bg-background text-foreground">
    <SiteNav active="/portfolio" />

    <div class="max-w-[1120px] w-[90%] mx-auto pt-6 sm:pt-10 pb-12 sm:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm">
          <li><a href="/portfolio" class="text-muted-foreground transition-colors hover:text-foreground">Portfolio</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li aria-current="page" class="font-medium" style={`color:${accent}`}>{title}</li>
        </ol>
      </nav>

      <header class="mb-10">
        <h1 class="font-bold tracking-tight text-[32px] sm:text-[52px] leading-[1.05]">{title}</h1>
        <p class="mt-4 max-w-5xl text-[18px] sm:text-[22px] leading-snug text-muted-foreground text-pretty">{tagline}</p>
      </header>

      <!-- Meta bar (horizontal columns) + high-level summary, in a rounded card -->
      <div class="mb-12 rounded-2xl border border-border bg-muted/30 px-6 py-8 sm:px-10 sm:py-10">
        <div class="grid grid-cols-2 gap-x-6 gap-y-6 sm:flex sm:justify-between sm:gap-8">
          {metaRows.map((row) => (
            <div class="sm:flex-1">
              <p class="mb-1.5 text-xs font-medium uppercase tracking-widest text-muted-foreground">{row.label}</p>
              <p class="text-sm text-foreground">{row.value}</p>
            </div>
          ))}
        </div>
        <div class="mt-8 space-y-3 border-t border-border pt-8 text-center">
          <p class="text-xs font-medium uppercase tracking-widest text-muted-foreground">High Level Summary</p>
          <p class="mx-auto max-w-3xl text-[17px] leading-relaxed text-foreground text-pretty">{summary}</p>
        </div>
      </div>

      <!-- In-page ToC — horizontal jump links to each section. Sits under the
           summary, then sticks below the site nav as you scroll. -->
      {sections.length > 0 && (
        <nav
          aria-label="On this page"
          data-toc
          class="sticky top-12 z-20 -mx-[5vw] mb-10 border-b border-border bg-background/85 px-[5vw] backdrop-blur"
        >
          <ul class="flex gap-x-6 gap-y-1 overflow-x-auto py-3 text-sm [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
            {sections.map((s) => (
              <li class="shrink-0">
                <a
                  href={`#${s.id}`}
                  data-toc-link={s.id}
                  class="font-medium text-muted-foreground transition-colors hover:text-foreground"
                >
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <!-- MDX body -->
      <article class="prose prose-slate max-w-none prose-headings:tracking-tight prose-headings:font-semibold prose-a:text-primary prose-a:font-medium [&_:is(h2,h3)]:scroll-mt-28 prose-h2:text-[20px] sm:prose-h2:text-[24px]">
        <slot />
      </article>
    </div>

    <SiteFooter />
    <BackToTop />
    <Lightbox />
  </main>

  <!-- Highlight the ToC link for the section currently in view. -->
  <script is:inline define:vars={{ accent }}>
    (() => {
      const links = new Map(
        [...document.querySelectorAll("[data-toc-link]")].map((a) => [a.getAttribute("data-toc-link"), a]),
      );
      if (!links.size) return;
      const headings = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean);
      let current = null;
      const setActive = (id) => {
        if (id === current) return;
        current = id;
        links.forEach((a, key) => {
          const on = key === id;
          a.style.color = on ? accent : "";
          a.classList.toggle("text-muted-foreground", !on);
        });
      };
      const onScroll = () => {
        const top = 120; // just below the sticky nav + ToC
        let active = headings[0]?.id ?? null;
        for (const h of headings) {
          if (h.getBoundingClientRect().top <= top) active = h.id;
        }
        // At the bottom of the page the last heading may never cross the top
        // threshold (short final section) — force it active once scrolled to end.
        const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
        if (atBottom) active = headings[headings.length - 1]?.id ?? active;
        setActive(active);
      };
      onScroll();
      window.addEventListener("scroll", onScroll, { passive: true });
    })();
  </script>
</Layout>
