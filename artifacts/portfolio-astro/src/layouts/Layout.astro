---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

// Shared page shell. Each route passes its own title/description/OG so every URL
// emits UNIQUE, real metadata in the raw HTML — the single biggest crawlability
// win over the current SPA, where every route shares one hardcoded <head>.
interface Props {
  title: string;
  description: string;
  /** Path only, e.g. "/services". Canonical + OG URL are resolved against `site`. */
  path: string;
  /** Optional extra JSON-LD structured-data objects to inline in <head>. */
  jsonLd?: Record<string, unknown>[];
  ogImage?: string;
}

const { title, description, path, jsonLd = [], ogImage = "/opengraph.jpg" } = Astro.props;

const site = Astro.site ?? new URL("https://wordsbyvern.com");
const canonical = new URL(path, site).href;
const ogImageUrl = new URL(ogImage, site).href;

// Person schema is present on every page so AI/search always have an entity to
// attach the site's content to.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Vernon Laquindanum",
  url: site.href,
  jobTitle: "Content Designer & Writer",
  sameAs: ["https://linkedin.com/in/vjtlaq", "https://medium.com/@vjtlaq"],
};

const schemas = [personSchema, ...jsonLd];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {/* Microsoft Clarity — heatmaps + session recordings (traffic behavior). */}
    <script is:inline type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "y8fgrn2h4r");
    </script>

    {
      schemas.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
