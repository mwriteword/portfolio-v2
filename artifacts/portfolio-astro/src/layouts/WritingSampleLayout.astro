---
import Layout from "./Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import BackToTop from "../components/BackToTop.astro";
import Lightbox from "../components/Lightbox.astro";

// "Case study lite" shell — a compact, deliverable-focused page for writing
// samples. No meta sidebar or chapter nav; just a light header, then the MDX body
// (mostly galleries). Kept deliberately simpler than CaseStudyLayout.
interface Props {
  title: string;
  eyebrow: string;
  client: string;
  role?: string;
  date?: string;
  accent: string;
  summary: string;
  description: string;
  path: string;
}
const { title, eyebrow, client, role, date, accent, summary, description, path } = Astro.props;

const metaBits = [client, role, date].filter(Boolean);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Portfolio", item: "https://wordsbyvern.com/portfolio" },
    { "@type": "ListItem", position: 2, name: title, item: `https://wordsbyvern.com${path}` },
  ],
};
const creativeWork = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: title,
  description,
  creator: { "@type": "Person", name: "Vernon Laquindanum", url: "https://wordsbyvern.com/about" },
};
---

<Layout title={`${title} — Vernon Laquindanum`} description={description} path={path} jsonLd={[creativeWork, breadcrumb]}>
  <main class="min-h-screen bg-background text-foreground">
    <SiteNav active="/portfolio" />

    <div class="max-w-[820px] w-[90%] mx-auto pt-6 pb-14 sm:pt-8 sm:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm">
          <li><a href="/portfolio" class="text-muted-foreground transition-colors hover:text-foreground">Portfolio</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li><a href="/portfolio#writing-samples" class="text-muted-foreground transition-colors hover:text-foreground">Writing samples</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li aria-current="page" class="font-medium text-foreground">{title}</li>
        </ol>
      </nav>

      <header class="mb-10">
        <p class="text-xs font-semibold uppercase tracking-widest" style={`color:${accent}`}>{eyebrow}</p>
        <h1 class="mt-3 font-bold tracking-tight text-[32px] sm:text-[44px] leading-[1.1]">{title}</h1>
        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
          {metaBits.map((bit, i) => (
            <>
              {i > 0 && <span aria-hidden="true">·</span>}
              <span>{bit}</span>
            </>
          ))}
        </p>
        <p class="mt-5 text-[17px] leading-relaxed text-foreground">{summary}</p>
      </header>

      <article class="prose prose-slate max-w-none prose-headings:tracking-tight prose-headings:font-semibold prose-a:text-primary prose-a:font-medium prose-h2:text-[20px] sm:prose-h2:text-[24px]">
        <slot />
      </article>

      <div class="mt-12">
        <a href="/portfolio#writing-samples" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">← All writing samples</a>
      </div>
    </div>

    <BackToTop />
    <Lightbox />
  </main>
</Layout>
