---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import ContactPanel from "../components/ContactPanel.tsx";
import { services } from "../data/services";

const AVATAR_SRC = "/images/avatar/illustration.png";
const LINKEDIN_URL = "https://linkedin.com/in/vjtlaq";
const MEDIUM_URL = "https://medium.com/@vjtlaq";
const EMAIL = "vjtlaq@gmail.com";

const title = "Vernon Laquindanum — Content Design & Systems for SaaS";
const description =
  "I've been a UX writer for 12 years, helping mid-sized B2B SaaS products grow out of their scrappy startup content phase — UX writing, content design, and content systems.";

// Featured case studies: the first two (by order) from the collection.
const featured = (await getCollection("caseStudies", ({ data }) => !data.draft && data.order < 10))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 2);

const logos = [
  { src: "/images/logos/atlassian.svg", alt: "Atlassian" },
  { src: "/images/logos/oracle-utilities.png", alt: "Oracle Utilities" },
  { src: "/images/logos/coursehero.svg", alt: "Course Hero" },
  { src: "/images/logos/quinstreet.svg", alt: "QuinStreet" },
];

// Verified recommendations. The first three are shown by default; the arrows
// reveal the rest.
const testimonials = [
  {
    quote:
      "Vern is exactly the kind of content designer that every switched-on tech leader needs in their team. He can flex in every direction without losing a beat in delivering high quality or velocity.",
    name: "Libby Varcoe",
    role: "Head of Content Design, Atlassian",
  },
  {
    quote:
      "I worked with Vern for over 4 years at Oracle Utilities on the same UX team, and I hired him again for a short-term contract to help manage our tip content. The work required rigorous fact-checking and careful editorial judgment, and I trusted Vern to get it right.",
    name: "Lauren Gritzke",
    role: "Senior Advisor, Energy Equity at Oracle Utilities",
  },
  {
    quote:
      "Vern is a strong writer and extremely reliable. He played a significant role in getting our Textbook Solutions product off the ground, easily adapting to any change or request. If you need clear, high-quality writing, look no further.",
    name: "John Peacock",
    role: "CEO at Course Hero",
  },
  {
    quote:
      "Vern is the kind of collaborator who becomes the steel thread across projects — generous with his time, genuine in his partnerships, and an absolute pleasure to work alongside. Any team that gets to work with Vern will feel the difference from day one.",
    name: "Anthony C.",
    role: "Design Leader",
  },
  {
    quote:
      "Vernon is super approachable and easy to jam with. He's a genuinely people-focused person who makes work enjoyable, and he's also comfortable jumping into the design tools, which made collaboration feel so much more seamless. He's such a vital teammate, thoughtful and generous with his thinking, and an absolute expert at what he does.",
    name: "Tim H.",
    role: "Product Designer",
  },
  {
    quote:
      "Vern brought an exceptional level of craft and care to his work, keeping the customer at the centre of everything he did and thoughtfully shaping every piece of messaging to ensure it's clear, purposeful, and high quality. He really is a team on his own.",
    name: "Ge G.",
    role: "Product Designer",
  },
];

// Short snippets for the auto-scrolling marquee under the hero.
const snippets = [
  "Any team that gets to work with Vern will feel the difference from day one.",
  "He really is a team on his own.",
  "An absolute expert at what he does.",
  "Flexes in every direction without losing a beat.",
  "I trusted Vern to get it right.",
  "If you need clear, high-quality writing, look no further.",
];

const professionalService = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Vernon Laquindanum — Content Design & Systems",
  description,
  url: "https://wordsbyvern.com/",
  provider: { "@type": "Person", name: "Vernon Laquindanum" },
  areaServed: "Worldwide",
  knowsAbout: ["UX writing", "Content design", "Content strategy", "SaaS onboarding", "AI content design"],
};
---

<Layout title={title} description={description} path="/" jsonLd={[professionalService]}>
  <main class="min-h-screen bg-background text-foreground">
    <SiteNav active="/" />

    <!-- 1 — Hero (lavender band) -->
    <section class="bg-indigo-50/70">
      <div class="max-w-[1120px] w-[90%] mx-auto py-16 sm:py-24 text-center">
        <h1 class="mx-auto max-w-4xl font-bold tracking-tight text-[30px] sm:text-[40px] lg:text-[48px] leading-[1.1]">
          Hello! I'm Vern, and I'm a UX Copywriter.
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-balance text-[16px] sm:text-[20px] text-muted-foreground">
          I make complex B2B SaaS easier to use by writing clear interface copy and creating systems
          that scale with the product.
        </p>
        <div class="mt-9 flex flex-wrap justify-center gap-3">
          <a href="/services" class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2.5 text-sm font-medium text-white transition-colors hover:bg-indigo-700">
            View my services
          </a>
          <a href="/portfolio" class="inline-flex items-center gap-2 rounded-lg border border-border bg-card px-5 py-2.5 text-sm font-medium text-foreground transition-colors hover:bg-muted">
            See my work →
          </a>
        </div>
      </div>
    </section>

    <!-- 2 — Logo bar + testimonial marquee -->
    <section class="border-y border-border">
      <div class="max-w-[1120px] w-[90%] mx-auto py-8">
        <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 sm:gap-x-16">
          {logos.map((l) => (
            <img src={l.src} alt={l.alt} class="max-h-8 w-auto max-w-[110px] object-contain opacity-70 grayscale transition-all duration-300 hover:opacity-100 hover:grayscale-0 sm:max-h-9" onerror="this.style.display='none'" />
          ))}
        </div>
        <div class="marquee mt-6 overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_8%,black_92%,transparent)]">
          <div class="marquee-track flex w-max gap-8">
            {[...snippets, ...snippets].map((s) => (
              <span class="flex items-center gap-8 whitespace-nowrap text-sm italic text-muted-foreground">
                “{s}”
                <span aria-hidden="true" class="text-muted-foreground/40">•</span>
              </span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- 3 — Writing services (offerings master-detail) -->
    <section id="services" class="scroll-mt-20">
      <div class="max-w-[1120px] w-[90%] mx-auto py-14 sm:py-20">
        <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight">Writing services</h2>
        <p class="mt-2 mb-8 max-w-2xl text-pretty text-muted-foreground">These are just a few of my UX content specialities. You can always book a call and we'll work out a customized solution together.</p>
        <div id="offerings-preview" class="grid gap-8 lg:grid-cols-[300px_1fr] lg:gap-14">
          <div>
            <nav class="flex flex-col gap-1">
              {
                services.map((s, i) => (
                  <button
                    type="button"
                    data-off-btn={i}
                    style={`--svc-accent:${s.accent}`}
                    class="off-btn group flex w-full items-baseline gap-3 rounded-r-lg border-l-[3px] border-transparent px-4 py-3 text-left transition-colors"
                  >
                    <span class="off-num font-mono text-xs tabular-nums text-muted-foreground/50 transition-colors">
                      {String(i + 1).padStart(2, "0")}
                    </span>
                    <span class="off-title text-[17px] font-medium leading-snug text-muted-foreground transition-colors group-hover:text-foreground">
                      {s.title}
                    </span>
                  </button>
                ))
              }
            </nav>
            <a href="/services" class="mt-5 ml-4 inline-flex items-center gap-1.5 text-sm font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline">
              View all services →
            </a>
          </div>
          <div class="lg:pt-2">
            {
              services.map((s, i) => (
                <div class="off-panel" data-off-panel={i} hidden={i !== 0}>
                  <p class="text-xs font-semibold uppercase tracking-wide" style={`color:${s.accent}`}>{s.eyebrow}</p>
                  <h3 class="mt-2 text-2xl font-bold tracking-tight">{s.title}</h3>
                  <p class="mt-3 max-w-2xl text-[17px] leading-relaxed text-muted-foreground">{s.summary}</p>
                  <a href={`/services#${s.slug}`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline" style={`color:${s.accent}`}>
                    More about this service →
                  </a>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 4 — Featured case studies (lavender band) -->
    <section class="border-y border-border bg-indigo-50/70">
      <div class="max-w-[1120px] w-[90%] mx-auto py-14 sm:py-20">
        <div class="mb-8 flex items-end justify-between gap-4">
          <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight">Featured case studies</h2>
          <a href="/portfolio" class="shrink-0 text-sm font-medium text-primary underline-offset-4 hover:underline">View all of my work →</a>
        </div>
        <div class="grid gap-6 sm:grid-cols-2">
          {
            featured.map((s) => (
              <a href={`/portfolio/case-study/${s.id}`} class="group flex flex-col overflow-hidden rounded-xl border border-border bg-card transition-colors hover:bg-muted">
                <div class="aspect-[16/10] w-full overflow-hidden bg-muted">
                  {(s.data.thumbnail ?? s.data.teaserImage) && (
                    <img src={s.data.thumbnail ?? s.data.teaserImage} alt={s.data.title} class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02]" onerror="this.style.display='none'" />
                  )}
                </div>
                <div class="p-5">
                  <h3 class="font-semibold">{s.data.title}</h3>
                  <p class="mt-1.5 text-sm leading-relaxed text-muted-foreground">{s.data.tagline}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5 — Recommendations (3-up carousel) -->
    <section class="scroll-mt-20">
      <div class="max-w-[1120px] w-[90%] mx-auto py-14 sm:py-20">
        <div class="mb-8 flex items-center justify-between gap-4">
          <h2 class="text-[20px] sm:text-[24px] font-semibold tracking-tight">Recommendations</h2>
          <div class="flex items-center gap-2" id="rec-carousel-controls">
            <button type="button" data-rec-prev aria-label="Previous recommendations" class="rounded-full border border-border p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <button type="button" data-rec-next aria-label="More recommendations" class="rounded-full border border-border p-1.5 text-muted-foreground transition-colors hover:bg-muted hover:text-foreground">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
        <div id="rec-carousel" class="-mx-1 overflow-x-auto pb-2 [scrollbar-width:none]" data-rec-track>
          <div class="flex gap-6 px-1">
            {
              testimonials.map((t) => (
                <figure class="flex w-[85%] shrink-0 snap-start flex-col rounded-2xl border border-border bg-card p-6 sm:w-[calc(50%-0.75rem)] lg:w-[calc(33.333%-1rem)]">
                  <blockquote class="flex-1 text-[15px] leading-relaxed text-foreground">“{t.quote}”</blockquote>
                  <figcaption class="mt-5 border-t border-border pt-4 text-sm">
                    <span class="font-semibold text-foreground">{t.name}</span>
                    <span class="mt-0.5 block text-muted-foreground">{t.role}</span>
                  </figcaption>
                </figure>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    <!-- 6 — About me (lavender band) -->
    <section id="about" class="scroll-mt-20 border-y border-border bg-indigo-50/70">
      <div class="max-w-[1120px] w-[90%] mx-auto py-14 sm:py-20">
        <h2 class="mb-6 text-[20px] sm:text-[24px] font-semibold tracking-tight">About me</h2>
        <div class="flex flex-col gap-10 lg:flex-row lg:gap-16">
          <div class="min-w-0 flex-1">
            <div class="space-y-4 text-[15px] sm:text-[17px] leading-relaxed text-muted-foreground">
              <p>
                I've been a professional writer for over 12 years, with the large majority of that
                focused on UX writing. I worked on energy efficiency products in the utility industry,
                navigating complex industry jargon and strict compliance requirements. I've worked on
                large-scale B2B SaaS products, building these content systems and standards from 0 and
                extending them across 4 separate apps. My work has driven real impact, with one email
                program driving clarity and behavior change at a utility with over 1 million households.
              </p>
              <p>
                I've solved the content problems you're experiencing at companies like Atlassian and
                Oracle. I'm ready (and excited) to solve yours next.
              </p>
            </div>
            <a href="/about" class="mt-8 inline-flex items-center gap-1.5 text-sm font-medium text-foreground underline-offset-4 hover:underline">
              More about me →
            </a>
          </div>

          <div class="flex shrink-0 flex-col items-start gap-3 lg:w-72 lg:items-center">
            <div class="w-full overflow-hidden rounded-xl bg-muted">
              <img src="/images/about/portrait.jpg" alt="Vern with a group of colleagues" class="h-full w-full object-cover" />
            </div>
            <p class="text-xs text-muted-foreground">I'm the one in the black shirt.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- 7 — Get in touch -->
    <section id="contact" class="scroll-mt-20">
      <div class="max-w-[1120px] w-[90%] mx-auto py-14 sm:py-20">
        <h2 class="mb-2 text-[20px] sm:text-[24px] font-semibold tracking-tight">Get in touch</h2>
        <p class="mb-6 max-w-2xl text-pretty text-sm text-muted-foreground">
          Think we'd make a good team? Send a message below or book an intro call now and we'll work on a solution together.
        </p>
        <ContactPanel client:visible />

        <div class="mt-12 flex justify-center">
          <a href="#" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            ↑ Back to top
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
  </main>
</Layout>

<style>
  .off-btn.is-active {
    border-left-color: var(--svc-accent);
    background-color: color-mix(in srgb, var(--svc-accent) 8%, transparent);
  }
  .off-btn.is-active .off-num,
  .off-btn.is-active .off-title {
    color: var(--svc-accent);
    font-weight: 600;
  }

  @keyframes marquee {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .marquee-track { animation: marquee 70s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation: none; }
  }
</style>

<script>
  // Offerings preview: hover/focus/click a rail item to reveal its panel.
  const preview = document.getElementById("offerings-preview");
  if (preview) {
    const btns = preview.querySelectorAll<HTMLElement>("[data-off-btn]");
    const panels = preview.querySelectorAll<HTMLElement>("[data-off-panel]");
    const show = (idx: string) => {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.offBtn === idx));
      panels.forEach((p) => p.toggleAttribute("hidden", p.dataset.offPanel !== idx));
    };
    btns.forEach((b) => {
      const idx = b.dataset.offBtn!;
      b.addEventListener("mouseenter", () => show(idx));
      b.addEventListener("focus", () => show(idx));
      b.addEventListener("click", () => show(idx));
    });
    show("0");
  }

  // Recommendations carousel: prev/next scroll the track by one card.
  const rec = document.getElementById("rec-carousel");
  if (rec) {
    const controls = document.getElementById("rec-carousel-controls");
    const card = rec.querySelector<HTMLElement>("figure");
    const step = () => (card?.offsetWidth ?? 320) + 24;
    controls?.querySelector("[data-rec-prev]")?.addEventListener("click", () => rec.scrollBy({ left: -step(), behavior: "smooth" }));
    controls?.querySelector("[data-rec-next]")?.addEventListener("click", () => rec.scrollBy({ left: step(), behavior: "smooth" }));
  }
</script>
