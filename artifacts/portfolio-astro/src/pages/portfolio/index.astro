---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import SiteNav from "../../components/SiteNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ContactPanel from "../../components/ContactPanel.tsx";
import Lightbox from "../../components/Lightbox.astro";
import WorkSamples from "../../components/WorkSamples.astro";
import { writingSamples, writingFilters } from "../../data/writing-samples";
import { tools, skillCategories, proficiencyConfig, EMPTY_DOT, type Proficiency } from "../../data/portfolio-data";

const title = "UX Portfolio — Vernon Laquindanum, Content Designer";
const description =
  "Selected content design and UX writing work by Vernon Laquindanum — content systems, AI content, onboarding, and behavior-change writing at Atlassian, Opower, Course Hero, and QuinStreet.";

// The 5 real case studies (order < 10), sorted.
const studies = (await getCollection("caseStudies", ({ data }) => !data.draft && data.order < 10)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Lucide icon inner-markup per case-study slug.
const icons: Record<string, string> = {
  "goal-types": '<circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>',
  twc: '<circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/>',
  "bls-emails": '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  "her-redesign": '<path d="M12 14 16 10"/><path d="M3.34 19a10 10 0 1 1 17.32 0"/>',
  "risk-agent": '<path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>',
};

const jumpSections = [
  { id: "case-studies", label: "UX case studies" },
  { id: "writing-samples", label: "Writing samples" },
  { id: "skills", label: "Skills" },
  { id: "tools", label: "Tools" },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "UX Portfolio — Vernon Laquindanum",
  description,
  url: "https://wordsbyvern.com/portfolio",
  hasPart: studies.map((s) => ({
    "@type": "CreativeWork",
    name: s.data.title,
    url: `https://wordsbyvern.com/portfolio/case-study/${s.id}`,
  })),
};

const dotStyle = (dot: { color: string; half?: boolean }) =>
  dot.half
    ? `background:linear-gradient(to right, ${dot.color} 50%, ${EMPTY_DOT} 50%)`
    : `background-color:${dot.color}`;
---

<Layout title={title} description={description} path="/portfolio" jsonLd={[collectionSchema]}>
  <main class="min-h-screen bg-background text-foreground">
    <SiteNav active="/portfolio" sections={jumpSections} />

    <!-- Header band -->
    <section class="bg-indigo-50/70 border-b border-border">
      <div class="max-w-[1120px] w-[90%] mx-auto py-10 sm:py-14">
        <nav aria-label="Breadcrumb" class="mb-4">
          <ol class="flex flex-wrap items-center gap-2 text-sm">
            <li><a href="/" class="text-muted-foreground transition-colors hover:text-foreground">Home</a></li>
            <li aria-hidden="true" class="text-muted-foreground/40">/</li>
            <li aria-current="page" class="font-medium text-foreground">Portfolio</li>
          </ol>
        </nav>
        <h1 class="font-bold tracking-tight text-[36px] sm:text-[48px] leading-[1.05]">Portfolio work</h1>
        <nav aria-label="Jump to section" class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
          <span class="text-muted-foreground">Jump to:</span>
          {jumpSections.map((s) => (
            <a href={`#${s.id}`} class="font-medium text-primary underline-offset-4 hover:underline">{s.label}</a>
          ))}
        </nav>
      </div>
    </section>

    <div class="max-w-[1120px] w-[90%] mx-auto">
      <!-- UX case studies -->
      <section id="case-studies" class="scroll-mt-20 py-14 sm:py-20">
        <h2 class="mb-6 text-[20px] sm:text-[24px] font-semibold tracking-tight">UX case studies</h2>
        <div class="divide-y divide-border">
          {
            studies.map((s, i) => {
              const d = s.data;
              return (
                <a href={`/portfolio/case-study/${s.id}`} class="group flex items-center gap-4 -mx-3 rounded-xl px-3 py-4 transition-colors hover:bg-muted">
                  <span class="w-6 shrink-0 font-mono text-xs tabular-nums text-muted-foreground">{String(i + 1).padStart(2, "0")}</span>
                  <div class="flex h-12 w-16 shrink-0 items-center justify-center rounded-md" style={`background-color:${d.accent}1a`}>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor" style={`color:${d.accent}`} set:html={icons[s.id] ?? icons["goal-types"]} />
                  </div>
                  <div class="min-w-0 flex-1">
                    <p class="truncate font-medium text-foreground">{d.title}</p>
                    <p class="mt-0.5 text-xs text-slate-600">{d.company}</p>
                    <!-- Phone: tags wrap below (no hover to reveal the tagline) -->
                    <div class="mt-2 flex flex-wrap gap-1.5 sm:hidden">
                      {d.skills.slice(0, 3).map((tag) => (
                        <span class="whitespace-nowrap rounded-full border border-border px-2.5 py-0.5 text-[11px] text-muted-foreground">{tag}</span>
                      ))}
                    </div>
                    <div class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-hover:grid-rows-[1fr]">
                      <div class="overflow-hidden">
                        <p class="pt-1.5 pr-4 text-sm leading-relaxed text-muted-foreground">{d.tagline}</p>
                      </div>
                    </div>
                  </div>
                  <div class="hidden shrink-0 items-center gap-1.5 sm:flex">
                    {d.skills.slice(0, 3).map((tag) => (
                      <span class="whitespace-nowrap rounded-full border border-border px-2.5 py-1 text-[11px] text-muted-foreground transition-colors group-hover:text-foreground">{tag}</span>
                    ))}
                  </div>
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 opacity-0 transition-opacity group-hover:opacity-100" style={`color:${d.accent}`}><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                </a>
              );
            })
          }
        </div>
      </section>
    </div>

    <!-- Writing samples (lavender band) -->
    <section id="writing-samples" class="scroll-mt-20 border-y border-border bg-indigo-50/70 py-14 sm:py-20">
      <div class="max-w-[1120px] w-[90%] mx-auto">
        <h2 class="mb-2 text-[20px] sm:text-[24px] font-semibold tracking-tight">Writing samples</h2>
        <p class="mb-6 max-w-2xl text-sm text-muted-foreground">
          A cross-section of copywriting, SEO, editorial, and long-form work from 12 years of professional writing.
        </p>
        <WorkSamples samples={writingSamples} filterGroups={writingFilters} />
      </div>
    </section>

    <div class="max-w-[1120px] w-[90%] mx-auto">
      <!-- Skills -->
      <section id="skills" class="scroll-mt-20 py-14 sm:py-20">
        <h2 class="mb-6 text-[20px] sm:text-[24px] font-semibold tracking-tight">Skills I've developed</h2>
        <div class="grid grid-cols-1 gap-x-10 gap-y-8 md:grid-cols-2">
          {
            skillCategories.map((category) => (
              <div>
                <h3 class="mb-4 text-xs font-semibold uppercase tracking-widest text-muted-foreground">{category.name}</h3>
                <div class="flex flex-wrap gap-2">
                  {category.skills.map((skill) => (
                    <span class="skill-pill cursor-default select-none rounded-full border px-3.5 py-1.5 text-sm" style={`--cat-accent:${category.color}`}>{skill}</span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>
    </div>

    <!-- Tools (lavender band) -->
    <section id="tools" class="scroll-mt-20 border-y border-border bg-indigo-50/70 py-14 sm:py-20">
      <div class="max-w-[1120px] w-[90%] mx-auto">
        <h2 class="mb-6 text-[20px] sm:text-[24px] font-semibold tracking-tight">Tools I've used</h2>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1fr_2fr] lg:gap-10" data-tools>
          <div class="order-1 self-start lg:order-2 lg:sticky lg:top-16 w-full">
            <div class="rounded-xl border border-border bg-card p-6 sm:p-8">
              {
                tools.map((tool, ti) => {
                  const cfg = proficiencyConfig[tool.proficiency as Proficiency];
                  return (
                    <div data-tool-panel={tool.id} hidden={ti !== 0}>
                      <div class="mb-4 flex items-center gap-3">
                        <img src={tool.icon} alt={tool.name} class="h-7 w-7 shrink-0 object-contain" onerror="this.style.display='none'" />
                        <h3 class="text-lg font-semibold">{tool.name}</h3>
                      </div>
                      <div class="mb-5 flex items-center gap-2 border-b border-border pb-5">
                        <div class="flex gap-1">
                          {cfg.dots.map((dot) => <div class="h-2 w-2 overflow-hidden rounded-full" style={dotStyle(dot)} />)}
                        </div>
                        <span class="text-xs font-medium" style={`color:${cfg.labelColor}`}>{cfg.label}</span>
                      </div>
                      <ul class="space-y-3">
                        {tool.bullets.map((bullet) => (
                          <li class="flex items-start gap-2.5 text-sm leading-relaxed text-muted-foreground">
                            <span class="mt-1.5 h-1 w-1 shrink-0 rounded-full bg-muted-foreground/40" />
                            {bullet}
                          </li>
                        ))}
                      </ul>
                    </div>
                  );
                })
              }
            </div>
          </div>
          <div class="order-2 flex flex-col gap-0.5 lg:order-1">
            {
              tools.map((tool, ti) => {
                const cfg = proficiencyConfig[tool.proficiency as Proficiency];
                return (
                  <button type="button" data-tool-btn={tool.id} aria-label={`${tool.name} — ${cfg.label}`} class={`tool-btn flex items-center gap-3 rounded-lg py-2.5 pl-2 pr-3 text-left transition-colors ${ti === 0 ? "is-active" : ""}`} style={`--tool-accent:${cfg.labelColor}`}>
                    <span class="tool-bar h-5 w-0.5 shrink-0 rounded-full"></span>
                    <img src={tool.icon} alt="" class="tool-icon h-4 w-4 shrink-0 object-contain" onerror="this.style.display='none'" />
                    <span class="tool-name flex-1 text-sm font-medium">{tool.name}</span>
                    <div class="flex shrink-0 gap-1">
                      {cfg.dots.map((dot) => <div class="h-1.5 w-1.5 overflow-hidden rounded-full" style={dotStyle(dot)} />)}
                    </div>
                  </button>
                );
              })
            }
          </div>
        </div>
      </div>
    </section>

    <!-- Get in touch -->
    <section id="contact" class="scroll-mt-20 border-t border-border bg-muted/30 py-14 sm:py-20">
      <div class="max-w-[1120px] w-[90%] mx-auto">
        <h2 class="mb-2 text-[20px] sm:text-[24px] font-semibold tracking-tight">Get in touch</h2>
        <p class="mb-6 max-w-2xl text-sm text-muted-foreground">
          Interested in working with me? Tell me a little about your project below, and I'll respond within a day.
        </p>
        <ContactPanel client:visible />

        <div class="mt-12 flex justify-center">
          <a href="#" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">
            ↑ Back to top
          </a>
        </div>
      </div>
    </section>

    <SiteFooter />
    <Lightbox />
  </main>
</Layout>

<style>
  .skill-pill {
    color: var(--color-muted-foreground, #64748b);
    border-color: var(--color-border, #e2e8f0);
    transition-property: color, border-color;
    transition-duration: 1500ms;
    transition-delay: 100ms;
  }
  .skill-pill:hover {
    color: var(--cat-accent);
    border-color: var(--cat-accent);
    transition-duration: 150ms;
    transition-delay: 0ms;
  }

  .tool-btn .tool-bar { background-color: transparent; transition: background-color 0.2s; }
  .tool-btn .tool-name { color: #64748b; transition: color 0.2s; }
  .tool-btn:hover { background-color: #f1f5f9; }
  .tool-btn.is-active { background-color: #f1f5f9; }
  .tool-btn.is-active .tool-bar { background-color: var(--tool-accent); }
  .tool-btn.is-active .tool-name { color: #0f172a; }
</style>

<script>
  // Tools master-detail: hover/focus/click a tool to show its panel.
  const toolsRoot = document.querySelector("[data-tools]");
  if (toolsRoot) {
    const btns = toolsRoot.querySelectorAll<HTMLElement>("[data-tool-btn]");
    const panels = toolsRoot.querySelectorAll<HTMLElement>("[data-tool-panel]");
    const show = (id: string) => {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.toolBtn === id));
      panels.forEach((p) => p.toggleAttribute("hidden", p.dataset.toolPanel !== id));
    };
    btns.forEach((b) => {
      const id = b.dataset.toolBtn!;
      b.addEventListener("mouseenter", () => show(id));
      b.addEventListener("focus", () => show(id));
      b.addEventListener("click", () => show(id));
    });
  }
</script>
