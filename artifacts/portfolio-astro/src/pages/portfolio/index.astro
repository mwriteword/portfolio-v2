<style is:global>
  body {
    background-color: #2e2e2e;
  }
</style>

<style>
  /* Skill pills: light up in the category accent on hover, then fade slowly back
     to neutral (matches the original 1.5s ease-out). */
  .skill-pill {
    color: #aaaaaa;
    border-color: #3a3a3a;
    transition-property: color, border-color;
    transition-duration: 1500ms;
    transition-delay: 100ms;
  }
  .skill-pill:hover {
    color: var(--cat-accent);
    border-color: var(--cat-accent);
    transition-duration: 150ms;
    transition-delay: 0ms;
  }

  /* Tools rail: active tool. */
  .tool-btn .tool-bar { background-color: transparent; transition: background-color 0.2s; }
  .tool-btn .tool-name { color: #999999; transition: color 0.2s; }
  .tool-btn .tool-icon { filter: contrast(0) brightness(1.3); }
  .tool-btn:hover { background-color: #333333; }
  .tool-btn.is-active { background-color: #383838; }
  .tool-btn.is-active .tool-bar { background-color: var(--tool-accent); }
  .tool-btn.is-active .tool-name { color: #ffffff; }
  .tool-btn.is-active .tool-icon { filter: none; }
</style>

<script>
  // Copy-email buttons (hero + about).
  document.querySelectorAll<HTMLElement>("#copy-email, #copy-email-2").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const label = btn.querySelector<HTMLElement>("[data-copy-label]");
      if (!label) return;
      try {
        await navigator.clipboard.writeText(btn.dataset.email!);
        const original = label.textContent;
        label.textContent = "Copied!";
        setTimeout(() => (label.textContent = original), 1500);
      } catch {}
    });
  });

  // Work list: reveal case studies 5–6.
  const workToggle = document.querySelector<HTMLButtonElement>("[data-work-toggle]");
  const extras = document.querySelectorAll<HTMLElement>("[data-work-item][data-extra]");
  const workLabel = document.querySelector<HTMLElement>("[data-work-toggle-label]");
  const chevron = document.querySelector<HTMLElement>("[data-work-chevron]");
  let workOpen = false;
  workToggle?.addEventListener("click", () => {
    workOpen = !workOpen;
    extras.forEach((el) => el.toggleAttribute("hidden", !workOpen));
    if (workLabel) workLabel.textContent = workOpen ? "Show less" : "Show more";
    chevron?.classList.toggle("rotate-180", workOpen);
    workToggle.setAttribute("aria-expanded", String(workOpen));
  });

  // Tools master-detail: hover/focus/click a tool to show its panel.
  const toolsRoot = document.querySelector("[data-tools]");
  if (toolsRoot) {
    const btns = toolsRoot.querySelectorAll<HTMLElement>("[data-tool-btn]");
    const panels = toolsRoot.querySelectorAll<HTMLElement>("[data-tool-panel]");
    const show = (id: string) => {
      btns.forEach((b) => b.classList.toggle("is-active", b.dataset.toolBtn === id));
      panels.forEach((p) => p.toggleAttribute("hidden", p.dataset.toolPanel !== id));
    };
    btns.forEach((b) => {
      const id = b.dataset.toolBtn!;
      b.addEventListener("mouseenter", () => show(id));
      b.addEventListener("focus", () => show(id));
      b.addEventListener("click", () => show(id));
    });
  }
</script>
