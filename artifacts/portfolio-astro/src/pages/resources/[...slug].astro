---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WritingNav from "../../components/WritingNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { services } from "../../../../portfolio/src/content/services";

export async function getStaticPaths() {
  const entries = await getCollection("resources", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);

const path = `/resources/${entry.id}`;
const url = `https://wordsbyvern.com${path}`;
const iso = (date: Date) => date.toISOString();

const related = d.relatedService ? services.find((s) => s.slug === d.relatedService) : undefined;

// Format in UTC so the displayed date matches the frontmatter date exactly
// (a bare "2026-08-11" parses as UTC midnight; local formatting would show the 10th).
const dateFmt = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

// Structured data: a BlogPosting tied to the author entity, plus a BreadcrumbList,
// plus a FAQPage when the article defines FAQs — the trio that AI answer engines and
// Google parse to lift the content into answers and rich results.
const blogPosting = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: d.title,
  description: d.description,
  datePublished: iso(d.datePublished),
  dateModified: iso(d.dateModified ?? d.datePublished),
  author: { "@type": "Person", name: "Vernon Laquindanum", url: "https://wordsbyvern.com/about" },
  publisher: { "@type": "Person", name: "Vernon Laquindanum" },
  mainEntityOfPage: { "@type": "WebPage", "@id": url },
  ...(d.tags.length ? { keywords: d.tags.join(", ") } : {}),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://wordsbyvern.com/" },
    { "@type": "ListItem", position: 2, name: "Resources", item: "https://wordsbyvern.com/resources" },
    { "@type": "ListItem", position: 3, name: d.title, item: url },
  ],
};

const faqSchema =
  d.faqs.length > 0
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: d.faqs.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      }
    : null;

const jsonLd = [blogPosting, breadcrumb, ...(faqSchema ? [faqSchema] : [])];
const showUpdated = d.dateModified && d.dateModified.getTime() !== d.datePublished.getTime();
---

<Layout title={`${d.title} — Vernon Laquindanum`} description={d.description} path={path} jsonLd={jsonLd} ogImage={d.ogImage}>
  <main class="min-h-screen bg-background text-foreground">
    <WritingNav active="/resources" />

    <div class="max-w-[760px] w-[90%] mx-auto pt-6 pb-12 sm:pt-8 sm:pb-20">
      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex flex-wrap items-center gap-2 text-sm">
          <li><a href="/" class="text-muted-foreground transition-colors hover:text-foreground">Home</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li><a href="/resources" class="text-muted-foreground transition-colors hover:text-foreground">Resources</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li aria-current="page" class="font-medium text-foreground">{d.title}</li>
        </ol>
      </nav>

      <!-- Header -->
      <header class="mb-8">
        <h1 class="font-bold tracking-tight text-[32px] sm:text-[44px] leading-[1.1]">{d.title}</h1>
        <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted-foreground">
          <span>By Vernon Laquindanum</span>
          <span aria-hidden="true">·</span>
          <time datetime={iso(d.datePublished)}>{dateFmt(d.datePublished)}</time>
          {showUpdated && (
            <>
              <span aria-hidden="true">·</span>
              <span>Updated <time datetime={iso(d.dateModified!)}>{dateFmt(d.dateModified!)}</time></span>
            </>
          )}
        </p>
      </header>

      <!-- Answer-first lead: the quotable definition AI engines extract. -->
      <p class="mb-10 border-l-4 border-primary/60 bg-muted/40 px-5 py-4 text-[17px] sm:text-[19px] leading-relaxed text-foreground">
        {d.answer}
      </p>

      <!-- Article body (Markdown) -->
      <article class="prose prose-slate max-w-none prose-headings:tracking-tight prose-headings:font-bold prose-a:text-primary prose-a:font-medium">
        <Content />
      </article>

      <!-- FAQ — visible block; mirrors the FAQPage structured data above. -->
      {
        d.faqs.length > 0 && (
          <section class="mt-14 border-t border-border pt-10">
            <h2 class="text-[24px] font-bold tracking-tight">Frequently asked questions</h2>
            <div class="mt-6 divide-y divide-border">
              {d.faqs.map((f) => (
                <details class="group py-4">
                  <summary class="flex cursor-pointer items-center justify-between gap-4 text-[17px] font-semibold text-foreground">
                    {f.question}
                    <span class="text-muted-foreground transition-transform group-open:rotate-180" aria-hidden="true">⌄</span>
                  </summary>
                  <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">{f.answer}</p>
                </details>
              ))}
            </div>
          </section>
        )
      }

      <!-- Related service CTA — routes topical readers to the offering + a conversion. -->
      {
        related && (
          <aside class="mt-14 rounded-2xl border border-border bg-card p-6 sm:p-8">
            <p class="text-xs font-semibold uppercase tracking-wide" style={`color:${related.accent}`}>Related service</p>
            <h2 class="mt-2 text-[22px] font-bold tracking-tight">{related.title}</h2>
            <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{related.summary}</p>
            <a href={`/services#${related.slug}`} class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold underline-offset-4 hover:underline" style={`color:${related.accent}`}>
              Learn more about this service →
            </a>
          </aside>
        )
      }

      <div class="mt-12">
        <a href="/resources" class="text-sm font-medium text-muted-foreground transition-colors hover:text-foreground">← All resources</a>
      </div>
    </div>

    <SiteFooter />
  </main>
</Layout>
