---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import WritingNav from "../../components/WritingNav.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import { getMediumPosts } from "../../lib/medium.ts";

// Section 1 — Content design articles: the SEO/AEO "what is X" library, authored
// as local Markdown in content/resources. Empty for now (drafts excluded), so the
// section renders a "Coming soon" state.
const articles = (await getCollection("resources", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.datePublished.getTime() - a.data.datePublished.getTime(),
);

// Section 2 — Published articles: mirrored from Medium at build time.
const mediumPosts = await getMediumPosts();

const title = "UX Content resources, articles, and more";
const description =
  "Content design articles, published writing, and free resources on content design, UX writing, and content systems from Vernon Laquindanum.";

const dateFmt = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: "https://wordsbyvern.com/" },
    { "@type": "ListItem", position: 2, name: "Resources", item: "https://wordsbyvern.com/resources" },
  ],
};
---

<Layout title={title} description={description} path="/resources" jsonLd={[breadcrumb]}>
  <main class="min-h-screen bg-background text-foreground">
    <WritingNav active="/resources" />

    <div class="max-w-[900px] w-[90%] mx-auto pt-6 pb-12 sm:pt-8 sm:pb-20">
      <nav aria-label="Breadcrumb" class="mb-8">
        <ol class="flex items-center gap-2 text-sm">
          <li><a href="/" class="text-muted-foreground transition-colors hover:text-foreground">Home</a></li>
          <li aria-hidden="true" class="text-muted-foreground/40">»</li>
          <li aria-current="page" class="font-medium text-foreground">Resources</li>
        </ol>
      </nav>

      <section class="mb-12 sm:mb-16">
        <p class="text-xs font-semibold uppercase tracking-widest text-muted-foreground">Resources</p>
        <h1 class="mt-4 font-bold tracking-tight text-[40px] sm:text-[56px] leading-[1.05]">
          UX Content resources, articles, and more
        </h1>
      </section>

      <!-- Section 1 — Content design articles (coming soon) -->
      <section class="mb-14 sm:mb-16">
        <div class="mb-6 flex flex-wrap items-center gap-3 border-b border-border pb-4">
          <h2 class="text-[24px] sm:text-[28px] font-bold tracking-tight">Content design articles</h2>
          {articles.length === 0 && (
            <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
              Coming soon
            </span>
          )}
        </div>
        {
          articles.length === 0 ? (
            <p class="max-w-2xl text-[15px] leading-relaxed text-muted-foreground">
              Plain-language guides on content design, UX writing, and content systems — what they are, why they
              matter, and how to get them right. First pieces are in the works.
            </p>
          ) : (
            <ul class="flex flex-col gap-4">
              {articles.map((entry) => (
                <li>
                  <a
                    href={`/resources/${entry.id}`}
                    class="block rounded-2xl border border-border bg-card p-6 transition-colors hover:bg-muted/40"
                  >
                    <h3 class="text-[20px] sm:text-[22px] font-bold tracking-tight">{entry.data.title}</h3>
                    <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground">{entry.data.description}</p>
                    <p class="mt-3 text-xs text-muted-foreground">
                      <time datetime={entry.data.datePublished.toISOString()}>
                        {dateFmt(entry.data.datePublished)}
                      </time>
                    </p>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <!-- Section 2 — Published articles (mirrored from Medium) -->
      <section class="mb-14 sm:mb-16">
        <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-border pb-4">
          <h2 class="text-[24px] sm:text-[28px] font-bold tracking-tight">Published articles</h2>
          <a
            href="https://medium.com/@vjtlaq"
            target="_blank"
            rel="noopener noreferrer"
            class="text-sm font-medium text-muted-foreground underline-offset-4 transition-colors hover:text-foreground hover:underline"
          >
            View on Medium →
          </a>
        </div>
        {
          mediumPosts.length === 0 ? (
            <p class="max-w-2xl text-[15px] leading-relaxed text-muted-foreground">
              My latest writing lives on Medium.{" "}
              <a
                href="https://medium.com/@vjtlaq"
                target="_blank"
                rel="noopener noreferrer"
                class="font-medium text-foreground underline underline-offset-4"
              >
                Read it here →
              </a>
            </p>
          ) : (
            <ul class="flex flex-col gap-4">
              {mediumPosts.map((post) => (
                <li>
                  <a
                    href={post.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex gap-5 rounded-2xl border border-border bg-card p-5 sm:p-6 transition-colors hover:bg-muted/40"
                  >
                    {post.image && (
                      <img
                        src={post.image}
                        alt=""
                        loading="lazy"
                        class="hidden sm:block h-24 w-24 shrink-0 rounded-lg object-cover"
                      />
                    )}
                    <div class="min-w-0">
                      <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted-foreground">
                        {post.publication && (
                          <>
                            <span class="font-semibold text-foreground">{post.publication}</span>
                            <span aria-hidden="true">·</span>
                          </>
                        )}
                        <time datetime={post.pubDate.toISOString()}>{dateFmt(post.pubDate)}</time>
                      </p>
                      <h3 class="mt-1.5 text-[19px] sm:text-[21px] font-bold tracking-tight">{post.title}</h3>
                      <p class="mt-2 text-[15px] leading-relaxed text-muted-foreground line-clamp-2">
                        {post.excerpt}
                      </p>
                      <span class="mt-3 inline-block text-sm font-semibold text-primary underline-offset-4">
                        Read on Medium →
                      </span>
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </section>

      <!-- Section 3 — Free resources (coming soon) -->
      <section>
        <div class="mb-6 flex flex-wrap items-center gap-3 border-b border-border pb-4">
          <h2 class="text-[24px] sm:text-[28px] font-bold tracking-tight">Free resources</h2>
          <span class="rounded-full border border-border bg-muted px-3 py-1 text-xs font-semibold uppercase tracking-wide text-muted-foreground">
            Coming soon
          </span>
        </div>
        <p class="max-w-2xl text-[15px] leading-relaxed text-muted-foreground">
          Templates, checklists, and other practical tools you can put to work — coming soon.
        </p>
      </section>
    </div>

    <SiteFooter />
  </main>
</Layout>
